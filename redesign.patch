+    rows = []
+    covered: set[int] = set()
+    for entry in SCHEDULE:
+        covered.update(entry["weeks"])
+        labs = [lab for week in entry["weeks"] for lab in by_week.get(week, [])]
+        rows.append(schedule_row(entry["label"], entry["title"], entry["topics"], labs))
